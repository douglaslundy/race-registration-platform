# Database
# Use the pooler URL (port 6543) for DATABASE_URL and the direct URL (port 5432) for
# DIRECT_URL/migrations — no third-party deploy platform involved, this app runs on our own VPS
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Auth (NextAuth v5)
AUTH_SECRET="your-secret-here-min-32-chars"
AUTH_URL="http://localhost:3000"

# Payment Provider — "sandbox" | "mercadopago"
PAYMENT_PROVIDER="sandbox"

# Mercado Pago (obrigatorio se PAYMENT_PROVIDER=mercadopago)
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# WhatsApp (Evolution API) — segredo do webhook de confirmação de leitura
WHATSAPP_WEBHOOK_SECRET=""

# Google AdSense (OAuth) — criar em console.cloud.google.com, ativar "AdSense Management API"
GOOGLE_ADS_OAUTH_CLIENT_ID=""
GOOGLE_ADS_OAUTH_CLIENT_SECRET=""

# Storage (S3 compatible)
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"

# Email
EMAIL_PROVIDER="nodemailer"
EMAIL_FROM="noreply@corridasapp.com.br"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Corridas App"

# Platform fee (percentage in basis points, e.g. 1100 = 11%)
PLATFORM_FEE_BPS="1100"
